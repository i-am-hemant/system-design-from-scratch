# Cloudflare Pages response headers. Parsed by Pages, never served as an asset.
#
# Pages already sends X-Content-Type-Options: nosniff and
# Referrer-Policy: strict-origin-when-cross-origin on every asset, so those are
# not repeated here. What Pages does NOT get right for this site:
#
#   - llms.txt is served as text/plain, but it is markdown meant for agents
#   - the default Cache-Control is max-age=0, must-revalidate for everything,
#     which is correct for HTML and data.js but wasteful for style.css/app.js
#
# Deployments purge the Cloudflare edge cache, so long browser TTLs on static
# assets are safe: a new deploy changes the Etag and the CDN copy.

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300

/style.css
  Cache-Control: public, max-age=86400

/app.js
  Cache-Control: public, max-age=86400

/md.js
  Cache-Control: public, max-age=86400

# data.js is the generated curriculum index. A stale copy makes the site
# advertise lessons that changed, so it must always be revalidated.
/data.js
  Cache-Control: no-cache, must-revalidate

# The lesson page injects rendered markdown as innerHTML and loads KaTeX and
# Mermaid from jsdelivr, so scripts and styles are restricted to self + that CDN.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https://raw.githubusercontent.com; connect-src 'self' https://raw.githubusercontent.com; frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Preview deployments must never outrank the custom domain in search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
